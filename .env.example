# Server
PORT=4000
NODE_ENV=development

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_CONTENTGRADE_PRO=
STRIPE_PRICE_CONTENTGRADE_BUSINESS=
STRIPE_PRICE_CONTENTGRADE_TEAM=
STRIPE_PRICE_AUDIENCEDECODER=
STRIPE_PRICE_SESSION_MANAGER=
STRIPE_PRICE_TOKENS=
STRIPE_PRICE_TOKEN_SINGLE=
# $5 one-time "buy me a coffee" tip behind the stable https://bilko.run/coffee
# redirect — the shared Bilko tip jar (linked from the social-signals-trader
# dashboard and published as the npm `funding` URL of
# claude-code-session-manager). The PUBLICTRADES_ var names are historical;
# name the Stripe product something project-neutral (e.g. "Buy Bilko a
# coffee"), since that name is what every tipper sees at checkout.
# Without either var set, /coffee serves a 200 "temporarily unavailable" page.
# Set STRIPE_PRICE_* even if you also set the PAYMENT_LINK — the webhook and
# /checkout/success resolve the purchased product by matching the line item's
# price against the STRIPE_PRICE_* vars. With only the payment link set, a tip
# is booked as an AudienceDecoder report and the buyer is handed a Pro license
# key by fallback.
STRIPE_PRICE_PUBLICTRADES_COFFEE=
STRIPE_PAYMENT_LINK_PUBLICTRADES_COFFEE=
STRIPE_WEBHOOK_SECRET=

# Turso (persistent database)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Gemini API (powers PageRoast)
GEMINI_API_KEY=

# Anthropic API — Academy proxy (POST /api/academy/ask)
# Keep separate from any other Anthropic key so it can be rotated independently.
# Required in production: server refuses to start without it.
ANTHROPIC_API_KEY_ACADEMY=

# Public URL
PUBLIC_URL=https://bilko.run
