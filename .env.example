# Copy to .env for local dev (`pnpm dev:server` loads it if present). Never commit real values.
# Vars below are read via process.env.* / import.meta.env.* in server/, shared/, src/, scripts/, mcp-host-server/src/.

# ===== Required to run the site =====

# Port the API server listens on (defaults to 4000; Vite proxies /api there).
PORT=4000
# "development" locally, "production" on Render; production enables stricter startup checks.
NODE_ENV=development
# Public site URL, used in links, redirects and OG tags; wrong value breaks checkout redirects.
PUBLIC_URL=https://bilko.run
# Clerk secret key; without it the server cannot verify logins, so every signed-in route fails.
CLERK_SECRET_KEY=
# Clerk publishable key (frontend); without it the sign-in widget does not load.
VITE_CLERK_PUBLISHABLE_KEY=
# Turso database URL; without it the server falls back to a local SQLite file (data is not persistent in prod).
TURSO_DATABASE_URL=
# Turso auth token; without it a remote Turso database rejects every query.
TURSO_AUTH_TOKEN=

# ===== Optional features =====

# Frontend API base (default "/api"); only set it to point the UI at a different server.
VITE_API_URL=
# Local SQLite file path used when Turso is not configured; defaults to data/contentgrade.db.
BILKO_SQLITE_PATH=
# Gemini key; without it every AI scoring tool (PageRoast, HeadlineGrader, ...) returns an error.
GEMINI_API_KEY=
# Anthropic key for the Academy proxy (POST /api/academy/ask); production refuses to start without it.
ANTHROPIC_API_KEY_ACADEMY=
# Stripe secret key; without it checkout, refunds and credit purchases are disabled.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret; without it purchases are never credited.
STRIPE_WEBHOOK_SECRET=
# Stripe price IDs; a missing one makes that product's checkout unavailable.
STRIPE_PRICE_CONTENTGRADE_PRO=
STRIPE_PRICE_CONTENTGRADE_BUSINESS=
STRIPE_PRICE_CONTENTGRADE_TEAM=
STRIPE_PRICE_AUDIENCEDECODER=
STRIPE_PRICE_SESSION_MANAGER=
STRIPE_PRICE_TOKENS=
STRIPE_PRICE_TOKEN_SINGLE=
# Stripe payment link for the Pro plan; without it the Pro checkout falls back to the price ID.
STRIPE_PAYMENT_LINK_CONTENTGRADE_PRO=
# $5 "buy Bilko a coffee" tip behind https://bilko.run/coffee. Without either var /coffee shows "temporarily unavailable".
# Also set the PRICE var even with a payment link: the webhook matches purchases by price ID.
STRIPE_PRICE_PUBLICTRADES_COFFEE=
STRIPE_PAYMENT_LINK_PUBLICTRADES_COFFEE=
# Shared bearer for project snapshot/event endpoints; without it those endpoints reject all writes.
PROJECT_SNAPSHOT_TOKEN=
# HMAC key signing game scores; without it game score submissions are rejected.
BILKO_GAME_HMAC_KEY=
# Comma-separated emails allowed to use the Session Manager relay; empty means no extra restriction.
SM_RELAY_ALLOWED_EMAILS=
# Set to 1 to enforce the Content-Security-Policy instead of report-only.
BILKO_CSP_ENFORCE=
# Latest host-kit version shown on the admin observability page; without it that comparison is blank.
BILKO_LATEST_HOST_KIT=

# ===== Scripts and tooling only =====

# Site base URL for scripts/sanity-qa.ts and scripts/synthetic-monitor.ts (defaults to https://bilko.run).
BILKO_BASE=
# Stripe key read by scripts/cost-monitor.ts; without it the Stripe cost lines are skipped.
STRIPE_API_KEY=
# Checkout directory for the bilko-host MCP publish pipeline; defaults to ~/.local/state/bilko-host/publish-checkout.
BILKO_PUBLISH_CHECKOUT=
