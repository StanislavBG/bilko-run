node_modules/
# Also match a node_modules SYMLINK (worktrees link the main checkout's): a trailing-slash
# pattern only matches directories, so `git add -A` would commit a dangling link.
/node_modules
# Published bundles ship every gated file: Expo/Metro exports put package assets under assets/__node_modules/.pnpm/<pkg>/node_modules/.
!public/projects/**/node_modules/
# Anchored to repo root — only ignores ./dist (Vite) and ./dist-server (host server tsc).
# mcp-host-server/dist/ is intentionally tracked so sibling repos can reference
# the built server.js from .mcp.json without a build step.
/dist/
/dist-server/
# esbuild output for the Project Pages CLI pipeline — regenerated by
# `npm run build:project-pages-logic` / `npm run build:project-pages`.
scripts/project-pages/dist/
data/*.db
data/*.db-shm
data/*.db-wal
local.db
local.db-shm
local.db-wal
bilko.db
bilko.db-shm
bilko.db-wal
dev.db
dev.db-shm
dev.db-wal
.env
.env.local
.env.production
*.log
.DS_Store
test-results/
playwright-report/
# Claude Code local state stays out of git, EXCEPT the skills — blog-from-git's
# SKILL.md, blog.config.yaml and blog-ledger.md ARE the editorial source of truth
# (what's published, what rotation owes next). Losing them loses that memory.
# Runtime artifacts under drafts/ (heartbeat, state, unapproved drafts) stay local.
.claude/*
!.claude/skills/
.claude/skills/*/drafts/
# Session Manager's per-project working folder (records, pages, brief, scheduler
# and chat state): machine-local, never source. It holds chat transcripts that
# quote whatever agents wrote, and this repo is public (docs/identity-boundary.md).
# Untrack from the main checkout only, never from a worktree: landing that
# deletion deletes the live files. Nothing under it is committed; plan records
# stay in its plan-records/ folder.
session-manager-operations/

# Playwright MCP console logs and screenshots (local only).
.playwright-mcp/
